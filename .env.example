# Server
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/real-estate-investment

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Initial admin (seeded on first boot if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# File uploads
UPLOAD_DIR=./uploads
