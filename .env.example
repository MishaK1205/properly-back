# Server
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed browser origins ("*" allows any).
# A "*" inside an origin matches one hostname label, e.g. https://*.vercel.app
CORS_ORIGINS=https://properly.ge,https://www.properly.ge,https://*.vercel.app,http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/real-estate-investment

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Initial admin (seeded on first boot if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# File uploads (on Railway, point this at a mounted volume, e.g. /data/uploads)
UPLOAD_DIR=./uploads
